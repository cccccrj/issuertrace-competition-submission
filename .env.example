# Required in production so site operators can identify the collector owner.
COLLECTOR_CONTACT=https://github.com/cccccrj/-listed-company-event-intelligence-
# Overseas sources use these standard variables when present. Never commit credentials.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# 账号不在这里配：它们住在库里的 platform_users 表，用 `python -m api.users` 管理
# （见 docs/submission/01-部署与访问.md §二）。AUTH_USERNAME / AUTH_PASSWORD 这一对已经没有任何
# 代码在读，留着只会让人以为在这里配了个登录。
#
# AUTH_SECRET 给会话 Cookie 签名。不设则每个进程随机生成，服务一重启所有人立刻掉线——
# 部署到别的环境时这一行必须有。
# AUTH_SECRET=

# Event labelling model. Any OpenAI-compatible gateway works; the key itself
# belongs in the gitignored .env and must never be committed.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.zhizengzeng.com/v1
# LLM_MODEL=qwen-plus

# 研判助手（页面上的问答）单独选模型；不设则与 LLM_MODEL 相同。处理层的批量判定不受影响——
# 库里的裁决是 LLM_MODEL 产出的，换它就得全部重跑。研判助手参数见 docs/submission/04-模型与算法.md。
# ASSISTANT_MODEL=kimi-k3

# Alert dispatch. The allowlist is checked when a subscription is *created*, not
# when it fires, so a target nobody vetted never reaches the send path — which is
# also what closes the SSRF hole. Unset means loopback only.
# NOTIFY_WEBHOOK_ALLOWLIST=http://127.0.0.1:*,http://localhost:*
# NOTIFY_MAIL_FROM=alerts@example.invalid
#
# A webhook's signing secret is NOT set here under its own name. The subscription
# stores the *name* of the variable holding it (`secret_ref`), and the resolved
# value never enters the database or any response body. Export the named variable
# in the service environment and reference it by name.
# ALERT_HOOK_SECRET=
